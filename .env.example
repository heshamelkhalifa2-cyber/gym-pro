# GymPro Environment Variables
# Copy this file to .env.local for local development
# Add these to Vercel Dashboard > Settings > Environment Variables for production

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real values to GitHub
# 2. The ANON KEY is safe to use in frontend (it's public)
# 3. Never use the SERVICE ROLE KEY in frontend code
